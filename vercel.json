{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "src/app.ts": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/auto-post",
      "schedule": "19 13 * * *"
    },
    {
      "path": "/api/v1/cron/storage-cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
