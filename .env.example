# Required by both the Vercel API and the background worker
LIVE_MONGODB_URI=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# API authentication, CORS, and Vercel Cron
JWT_USER_SECRET=
REFRESH_TOKEN_SECRET=
CRON_SECRET=
FRONTEND_URL=
# Optional comma-separated list of additional exact origins
FRONTEND_URLS=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Payments
PAYSTACK_SECRET_KEY=

# SMS
TWILIO_ACC_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NO=

# Optional video worker tuning
RENDER_TIMEOUT_MS=1800000
QURAN_AUDIO_BITRATE=128
